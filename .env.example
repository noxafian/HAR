# Supabase browser-safe project settings. Local defaults are shown as placeholders.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key

# Server-only Supabase credential. NEVER expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Server-only AES-256-GCM key. Generate using: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=replace-with-64-character-lowercase-hex-key
ENCRYPTION_KEY_VERSION=1

# One-time initial owner bootstrap secret (minimum 32 characters, high entropy).
ADMIN_BOOTSTRAP_SECRET=replace-with-a-random-secret-at-least-32-characters

# Admin account — these credentials auto-approve and set the owner role on registration.
# Change these before deploying to production.
ADMIN_EMAIL=admin@keryvion.com
ADMIN_PASSWORD=Admin@studyhub2027

# Firebase Storage credentials (required for resource uploads/downloads).
# Get these from Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# The downloaded JSON file contains all values needed below:
# - projectId: Copy from the "project_id" field
# - clientEmail: Copy from the "client_email" field
# - privateKey: Copy from the "private_key" field (keep the \n escape sequences)
# - storageBucket: Found in Firebase Console > Storage, format: your-project-id.appspot.com
FIREBASE_PROJECT_ID=placeholder-project-id
FIREBASE_CLIENT_EMAIL=placeholder@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=placeholder-private-key
FIREBASE_STORAGE_BUCKET=placeholder-project.appspot.com

GROQ_API_KEY=your_key
OPENROUTER_API_KEY=your_key
GEMINI_API_KEY=your_key
